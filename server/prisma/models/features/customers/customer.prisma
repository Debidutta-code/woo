model Customers {
    id                      String   @id @default(uuid())
    firstName               String   @map("first_name")
    lastName                String   @map("last_name")
    email                   String   @unique @map("email")
    password                String   @map("password")
    mobilePhone             String   @unique @map("mobile_phone")
    referralCode            String?   @unique @map("referral_code")
    referralLink            String?   @map("referral_link")
    referralQRCode          String?   @map("referral_qr_code")
    promotionalEmailEnabled Boolean  @default(false) @map("promotional_email_enabled")
    isDeleted               Boolean  @default(false) @map("is_deleted")
    metaData                Json     @default("{}") @map("meta_data")
    
    Reviews                 Reviews[]
    WishList                WishList[]

    createdAt               DateTime @default(now()) @map("created_at")
    updatedAt               DateTime @updatedAt @map("updated_at")
    @@map("customers")
}
