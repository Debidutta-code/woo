model SeasonalDynamicPricing {
  id              String                       @id @default(uuid())
  dynamicId       String                       @map("dynamic_id")
  roomId          String                       @map("room_id")
  ruleName        String                       @map("rule_name")
  periodType      SeasonalDynamicPricingEnumType @map("period_type")
  startDate       DateTime                     @map("start_date")
  endDate         DateTime                     @map("end_date")
  adjustmentType  DiscountType                 @map("adjustment_type")
  adjustmentValue Float                        @map("adjustment_value")
  currencyCode    CurrencyCode?                @map("currency_code")
  pricingType     DynamicPricingPricingType      @default(increase) @map("pricing_type")
  minCap          Int?                         @map("min_cap")
  maxCap          Int?                         @map("max_cap")
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  dynamic DynamicPricing @relation(fields: [dynamicId], references: [id], onDelete: Cascade)
  room     Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("seasonal_dynamic_pricing")
}